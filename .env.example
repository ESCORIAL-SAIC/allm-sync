# Copiá este archivo a .env y completá los valores reales.
# NO commitees el .env (está en .gitignore).

# ─── Deploy ─────────────────────────────────────────────────────────────────
# Versión de imagen a bajar de GHCR (default :latest). Fijá una p. ej. 0.0.1.
IMAGE_TAG=latest
# Poné true para un primer arranque en seco (no modifica AnythingLLM, sólo loguea).
DRY_RUN=false

# ─── AnythingLLM ────────────────────────────────────────────────────────────
# URL interna del container de AnythingLLM (misma red docker, sin pasar por el
# reverse proxy -> evita 504/413). Es <nombre_container>:<puerto_interno>.
ALLM_BASE_URL=http://anythingllm:3001

# API key developer de AnythingLLM (Settings -> Tools -> Developer API).
# Es de nivel admin: tratala como una contraseña.
ALLM_API_KEY=

# ─── Share de Windows (SMB/CIFS) ────────────────────────────────────────────
# Ruta del recurso en formato //SERVIDOR/Recurso (con barras normales, no \).
# Los espacios van tal cual, sin comillas (p. ej. //192.168.1.116/SGC Escorial).
SMB_DEVICE=//FILESERVER/Documentos
SMB_USER=
SMB_PASS=
# Dominio AD. OJO: NO lo dejes vacío -> rompe el mount con "invalid argument".
# Si el fileserver usa cuentas locales (sin dominio), quitá 'domain=${SMB_DOMAIN},'
# de la línea 'o:' del volumen en docker-compose.yml.
SMB_DOMAIN=MIDOMINIO.COM
# Versión del protocolo SMB del fileserver (2.1 o 3.0 en la mayoría de Windows).
SMB_VERS=3.0
